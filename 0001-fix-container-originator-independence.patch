 .../agent/capabilities/search_hypothesis.py   |  25 ++--
 plugin/agent/decision.py                      |   4 +-
 plugin/agent/decision_consultation.py         |  16 ++-
 plugin/agent/goal.py                          |   3 +-
 plugin/agent/unified_cognition.py             |  10 +-
 plugin/evals/gates.py                         |  45 +++++-
 tests/plugin/test_search_episode.py           |   2 +
 .../plugin/test_search_hypothesis_ranking.py  | 136 +++++++++++++++++-
 9 files changed, 250 insertions(+), 30 deletions(-)

