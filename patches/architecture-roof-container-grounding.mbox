+    # x0y0x1y1 when c,d look like absolute corners past the origin.
+    if c > a and d > b and (c - a) >= 4 and (d - b) >= 4:
+        return (a, b, c, d)
+    # Otherwise xywh.
+    if c > 0 and d > 0:
+        return (a, b, a + c, b + d)
+    return None
