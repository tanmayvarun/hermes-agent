+        field_role="none",
+        label="",
+        text="zarooratwala",
+        point=(400.0, 400.0),
+        target_kind="",
+    )
+    vok, vwhy = validate_brief(brief)
+    assert not vok
+    assert "empty_kind" in vwhy or "wrong_locus" in vwhy
