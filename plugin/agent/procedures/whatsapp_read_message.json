    },
    {
      "id": "find_target_message",
      "objective": "find the message matching {link_query}",
      "required_predicates": ["source_object_selected"],
      "preferred_capabilities": ["OpenMessage", "OpenLink", "SelectContent"],
      "recovery": ["inspect nearby rows", "change the search hypothesis"],
      "reversible": true,
      "confidence_threshold": 0.55
    }
  ],
