+                "establishes_roles": ["source_container"],
+                "is_navigation": True,
+                "target_kind": content_kind,
+                "content_hit_not_container": True,
+            }
+        # Content-shaped open outside source-reaching: do not establish container.
+        return {
+            "family": fam,
+            "target_role": "",
+            "establishes_roles": [],
+            "is_navigation": False,
+            "target_kind": content_kind,
+            "content_hit_not_container": True,
