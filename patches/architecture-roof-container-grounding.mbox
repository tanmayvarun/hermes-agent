+            "capability": "invoke_affordance",
+            "target": "Forwarded",
+            "why": "forward",
+            "confidence": 0.9,
+        },
+        brief,
+    )
+    assert out.ok is False
+    assert "destination not selected" not in out.why
+    assert "metadata" in out.why or "Forwarded" in out.why
