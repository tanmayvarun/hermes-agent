{
  "id": "whatsapp_read_message",
  "title": "Read and inspect a message inside a chat thread",
  "app": "WhatsApp",
  "summary": "Open the conversation, inspect the timeline, and identify visible message content before any higher-risk action.",
  "goal_kinds": ["whatsapp_read_message", "whatsapp_search_message"],
