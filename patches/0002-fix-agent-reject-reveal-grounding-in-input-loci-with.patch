+    ]
+    score, why, n = _composer_mistype_score(events, "")
+    assert n >= 3
+    assert score >= 0.85
+    assert "composer_mistype" in why
+
+
+def test_brief_from_world_stamps_regions_for_validate():
+    doc = {
+        "surface": "conversation",
+        "scene_graph": _composer_scene(),
+        "objects": [
+            {
+                "id": "66",
+                "kind": "message",
