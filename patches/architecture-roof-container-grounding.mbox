+            conversation_open=True,
+            extras={},
+        ),
+    )
+    assert ts.source_chat_open is False
+    assert "ZarooratWala" in ts.open_conversation
+
+
+def test_reveal_requires_verified_source_container():
+    brief = DecisionBrief(
