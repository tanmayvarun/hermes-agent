+    world = WorldModel(active_app="WhatsApp")
+    proposal = UnifiedProposal(
+        observed_state={"surface": "conversation"},
+        world_model={"surface": "conversation"},
+        next_action={
+            "family": "invoke_affordance",
+            "target_label": "Forward",
+            "text": "Forward",
+            "confidence": 0.8,
