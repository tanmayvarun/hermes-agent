+                label_looks_like_composer,
+                label_looks_like_filter,
+            )
+            from plugin.executor.ax_action import _find_search_text_field
+
+            field, label = _find_search_text_field(self.app)
+            if field is None:
+                return False
+            lab = str(label or "").strip()
