+def test_foreign_container_locus_forbids_reveal():
+    """Defense in depth: locus_contract blocks patient caps on foreign open."""
+    from plugin.agent.capabilities.locus_contract import wrong_locus_forbidden
+
+    brief = DecisionBrief(
