+            "establishes_roles": ["source_container"],
+            "is_navigation": False,
+            "target_kind": kind_hint,
+        }
+    # Unknown semantic kind — not content, not therefore conversation.
+    return {
+        "family": fam,
+        "target_role": "source_container",
+        "establishes_roles": [],
+        "is_navigation": False,
+        "target_kind": "",
+        "unknown_kind": True,
+    }
