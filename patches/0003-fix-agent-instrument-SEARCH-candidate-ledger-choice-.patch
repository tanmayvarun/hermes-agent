@@ -740,6 +774,15 @@ def complete_search_choice(
         role_resolved=True,
         candidate_count=1,
     )
+    path = str(selection_path or "").strip()
+    if path and isinstance(ep, dict):
+        ep = {**ep, "selection_path": path}
+        try:
+            if execution_state is not None:
+                execution_state.search_episode = ep
+        except Exception:
+            pass
+    return ep
 
 
