+                phase=phase,
+                candidate=candidate,
+                target=target,
+                target_kind=target_kind,
+            ).get("target_role")
+            or ""
+        )
     if fam in {"select_content", "reveal_actions", "locate_content"}:
         return "source_object"
     if fam in {"type_query", "compose_search_query"}:
